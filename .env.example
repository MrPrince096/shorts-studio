# ---- Footage (required) ----
# Free Pexels key: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# ---- Script AI (LLM) ----
# Which AI writes the scripts: gemini | openai | ollama
LLM_PROVIDER=gemini

# Gemini (free): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI / GPT (optional): https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama — local & offline (optional): https://ollama.com
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---- AI video backgrounds (optional, paid) ----
# fal.ai runs Seedance / Veo / Kling: https://fal.ai/dashboard/keys
FAL_KEY=
