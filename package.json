{
  "name": "shorts-engine",
  "version": "1.0.0",
  "description": "Free faceless Shorts/Reels engine: edge-tts voiceover + Pexels stock + Remotion render",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server.mjs",
    "app": "node server.mjs",
    "desktop": "electron .",
    "icon": "python3 scripts/make-icon.py",
    "dist": "npm run icon && electron-builder --mac",
    "build": "node scripts/build.mjs",
    "studio": "remotion studio",
    "render": "remotion render Short out/video.mp4 --props=public/props.json",
    "make": "node scripts/make.mjs",
    "batch": "node scripts/batch.mjs",
    "mcp": "node mcp/shorts-studio-mcp.mjs"
  },
  "build": {
    "appId": "com.shortsstudio.app",
    "productName": "Shorts Studio",
    "directories": {
      "output": "dist-app",
      "buildResources": "build"
    },
    "asar": false,
    "files": [
      "electron/**/*",
      "server.mjs",
      "scripts/**/*",
      "src/**/*",
      "web/**/*",
      "remotion.config.*",
      "package.json",
      "build/icon.icns",
      "build/icon.png",
      "local-image-server/**/*",
      "local-voice-server/**/*",
      "start-local-servers.command",
      "stop-local-servers.command",
      "public/bg_*.mp3",
      "!**/*.map",
      "!**/{test,__tests__,tests,powered-test,example,examples}"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/icon.icns",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Shorts Studio",
      "contents": [
        { "x": 140, "y": 200 },
        { "x": 400, "y": 200, "type": "link", "path": "/Applications" }
      ]
    }
  },
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "@remotion/cli": "4.0.392",
    "express": "^4.22.2",
    "googleapis": "^173.0.0",
    "open": "^11.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.392"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
