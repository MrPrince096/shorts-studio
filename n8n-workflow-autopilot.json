{
  "name": "Shorts Autopilot — Daily Render",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 8,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "name": "Every day 8:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "command": "zsh -lc 'cd /Users/praneethguptha/Youtube/shorts-engine && node scripts/autopilot.mjs'"
      },
      "name": "Render next Short",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "leftValue": "={{ $json.stdout }}",
              "rightValue": "QUEUE_EMPTY",
              "operator": { "type": "string", "operation": "contains" }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "Queue empty?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "content": "## ⚠️ Queue is empty\nAsk Claude for more scripts:\n\"write 7 more queue scripts\"",
        "height": 120,
        "width": 240
      },
      "name": "Note: refill queue",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [660, -160]
    },
    {
      "parameters": {
        "command": "zsh -lc 'cat /Users/praneethguptha/Youtube/shorts-engine/out/last-render.json'"
      },
      "name": "Read render result",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [660, 100]
    }
  ],
  "connections": {
    "Every day 8:00": {
      "main": [[{ "node": "Render next Short", "type": "main", "index": 0 }]]
    },
    "Render next Short": {
      "main": [[{ "node": "Queue empty?", "type": "main", "index": 0 }]]
    },
    "Queue empty?": {
      "main": [
        [],
        [{ "node": "Read render result", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" }
}
